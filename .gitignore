# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers specs and plans (local scratch, not committed)
docs/superpowers/

# PRDs (local product docs, not committed)
docs/PRD/

# PRDs (local product docs, not committed)
docs/PRD/

*.agents

# impeccable detector cache (config.json and design.json are committed)
.impeccable/hook.cache.json
